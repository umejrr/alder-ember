---
import type { Faq } from '@/content/types';
interface Props {
  items: Faq[];
  /** open the first item by default */
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---
<div class="accordion">
  {items.map((f, i) => (
    <details open={openFirst && i === 0}>
      <summary>
        <span>{f.question}</span>
        <span class="icon" aria-hidden="true"></span>
      </summary>
      <div class="answer">
        {f.answer.map((p) => <p>{p}</p>)}
        {f.linkHref && (
          <p><a class="text-link" href={f.linkHref}>{f.linkLabel ?? 'Read more'} <span class="arrow" aria-hidden="true">→</span></a></p>
        )}
      </div>
    </details>
  ))}
</div>
