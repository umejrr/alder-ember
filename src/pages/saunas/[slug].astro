---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Picture from '@/components/Picture.astro';
import ModelFacts from '@/components/ModelFacts.astro';
import PriceBlock from '@/components/PriceBlock.astro';
import FaqList from '@/components/FaqList.astro';
import Gallery from '@/components/react/Gallery';
import ProductPanel from '@/components/react/ProductPanel';
import { productList, products } from '@/content/products';
import { discussableOptions, heatingChoices } from '@/content/options';
import { faqs, modelFaqs } from '@/content/faqs';
import { stages, site } from '@/content/site';
import { assetView } from '@/lib/model-view';
import { toModelView } from '@/lib/model-view';
import { publicProduct, capacityInWords } from '@/lib/format';
import { resolve, isWorking } from '@/lib/mode';
import { visibleInstallations } from '@/lib/visibility';
import type { Product } from '@/content/types';

export function getStaticPaths() {
  return productList.filter((p) => p.published).map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}
const { id } = Astro.props as { id: Product['id'] };
const product = products[id];
const pub = publicProduct(product);
const view = toModelView(product);
const images = product.gallery.map(assetView);
const others = productList.filter((p) => p.id !== id);
const heating = heatingChoices(id);
const options = discussableOptions(id);
const standard = resolve(product.standardPackage);
const leadTime = resolve(product.leadTime);
const highlights = resolve(product.highlights);
const coverage = resolve(site.coverage);
const projects = visibleInstallations().filter((p) => p.productId === id);
const relevantFaqs = [faqs.find((f) => f.id === 'price')!, ...modelFaqs, faqs.find((f) => f.id === 'next')!];
const crumbs = [{ label: 'Home', href: '/' }, { label: 'The saunas', href: '/saunas' }, { label: product.name }];
const cap = resolve(product.capacity);
const pendingText = 'Confirmed against the approved drawings during your site review';
---
<Base title={product.seoTitle} description={product.seoDescription} breadcrumbs={crumbs} bodyClass="has-sticky-cta" preloadFonts>
  <!-- Top: gallery + decision panel -->
  <section class="product-top container" data-product-top>
    <Breadcrumbs items={crumbs} />
    <div class="grid-12 product-top__grid">
      <div class="c-7">
        <Gallery client:load images={images} name={product.name} />
      </div>
      <aside class="c-5 product-top__panel" aria-label={`${product.name} summary`}>
        <div class="product-top__sticky">
          <p class="label muted">{pub.format ?? 'Outdoor sauna'}</p>
          <h1>{product.name}</h1>
          <p class="lead">{product.position}</p>
          <ModelFacts product={product} rows={['capacity', 'exterior']} />
          <PriceBlock product={product} compact />
          <ProductPanel
            client:load
            model={view}
            heating={heating}
            compareIds={productList.map((p) => p.id)}
            leadTime={leadTime}
            leadWorking={isWorking(product.leadTime)}
          />
        </div>
      </aside>
    </div>
  </section>

  <!-- Local navigation: sticks under the site header, marks the section in view -->
  <nav class="local-nav" aria-label={`${product.name} sections`} data-local-nav>
    <div class="container">
      <ul>
        <li><a href="#overview">Overview</a></li>
        <li><a href="#specifications">Dimensions</a></li>
        <li><a href="#included">What’s included</a></li>
        <li><a href="#heating">Heating</a></li>
        <li><a href="#planning">Installation</a></li>
        <li><a href="#faqs">Questions</a></li>
      </ul>
    </div>
  </nav>

  <!-- 1. Why this model: atmosphere chapter -->
  <section class="chapter is-forest is-forest-gradient" id="overview" aria-labelledby="why-title">
    <div class="container grid-12 chapter__grid">
      <div class="c-6 reveal">
        <Picture id={`${product.id}-interior`} sizes="(min-width: 60rem) 46vw, 100vw" />
      </div>
      <div class="c-5 c-start-8 chapter__copy">
        <p class="label">Why the {product.shortName}</p>
        <h2 id="why-title">{product.shortName === 'Rowan' ? 'Compact, for a smaller garden' : product.shortName === 'Alder' ? 'Room to share, with a glazed front' : 'Space for the whole household'}</h2>
        {pub.fit && <p class="lead">Suits: {pub.fit.charAt(0).toLowerCase() + pub.fit.slice(1)}.</p>}
        {highlights && <ul class="tick-list">{highlights.map((h) => <li>{h}</li>)}</ul>}
      </div>
    </div>
  </section>

  <!-- 2. Dimensions & specifications -->
  <section class="section" id="specifications" aria-labelledby="spec-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">The {product.shortName}</p>
        <h2 id="spec-title">Dimensions &amp; site planning</h2>
        <p class="muted" style="margin-top: var(--s-4)">
          The cabin and the space it needs are different things. We confirm the base, clearances and access for your site, rather than working them out from the cabin size.
        </p>
      </div>
      <div class="c-8 spec-groups">
        <div>
          <h3 class="h4">The cabin</h3>
          <ModelFacts product={product} rows={['format', 'capacity', 'exterior', 'interior', 'changing']} />
          {
            product.id === 'ember' && (
              <p class="note">The Ember is described with a changing area. How it is specified, and whether it is included or optional, is still being confirmed.</p>
            )
          }
        </div>
        <div>
          <h3 class="h4">Installation requirements</h3>
          <dl class="facts">
            <div><dt>Base</dt><dd><span class="pending">{pendingText}</span></dd></div>
            <div><dt>Access</dt><dd><span class="pending">{pendingText}</span></dd></div>
            <div><dt>Clearances</dt><dd><span class="pending">{pendingText}</span></dd></div>
            <div><dt>Weight</dt><dd><span class="pending">{pendingText}</span></dd></div>
          </dl>
          <p class="note">
            Base size, clearances, access requirements and weight come from the manufacturer’s approved drawings for your model and heater. We confirm them with you before your order is confirmed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What's included -->
  <section class="section is-surface" id="included" aria-labelledby="included-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">The package</p>
        <h2 id="included-title">What’s included</h2>
      </div>
      <div class="c-8 two-col">
        <div>
          <h3 class="h4">Standard package</h3>
          {
            standard ? (
              <ul class="plain-list">{standard.map((s) => <li>{s}</li>)}</ul>
            ) : (
              <p class="muted">The precise package for the {product.shortName} is confirmed in your quotation.</p>
            )
          }
          {isWorking(product.standardPackage) && <p class="note">Working list: confirmed against this model before it is published.</p>}
        </div>
        <div>
          <h3 class="h4">Installation scope</h3>
          <ul class="plain-list">
            <li>Assembly or positioning, as agreed</li>
            <li>Fitting of supplied components, within the agreed scope</li>
            <li>Installation checks</li>
            <li>Handover with you</li>
          </ul>
          <h3 class="h4" style="margin-top: var(--s-5)">Assessed separately</h3>
          <ul class="plain-list">
            <li>Ground preparation</li>
            <li>Electrical connection</li>
            <li>Specialist lifting</li>
            <li>Non-standard access work</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 + 5. Heating & options -->
  <section class="section" id="heating" aria-labelledby="heating-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">Heating &amp; options</p>
        <h2 id="heating-title">Heating options</h2>
        <p class="muted" style="margin-top: var(--s-4)">
          What you choose here is a preference. We confirm the configuration, and what is possible on your site, in your quotation.
        </p>
      </div>
      <div class="c-8 stack" style="--stack: var(--s-6)">
        <div>
          <h3 class="h4">Heating</h3>
          <ul class="choices">
            {heating.filter((h) => h.value !== 'advice').map((h) => (
              <li class={h.disabled ? 'is-off' : ''}>
                <span class="choices__name">{h.label}</span>
                <span class="chip">{h.disabled ? 'Not offered' : h.value === 'wood' ? 'Subject to assessment' : 'Available'}</span>
                <p>{h.value === 'electric' ? 'Suits customers who want straightforward controls and regular use.' : h.value === 'wood' ? (h.disabled ? 'Not offered on the Rowan in the supplied range.' : 'Selected configurations suit people who are comfortable tending a fire and managing the maintenance and site considerations that come with it.') : ''}</p>
              </li>
            ))}
          </ul>
          <p class="note">
            Equipment sizing, electrical supply, ventilation, flues and clearances follow the approved equipment specification. Warm-up varies by model, heater, starting temperature and weather, so we do not publish a single figure.
          </p>
        </div>
        <div>
          <h3 class="h4">Other options to discuss</h3>
          <ul class="plain-list plain-list--cols">
            {options.map((o) => <li>{o.label}</li>)}
          </ul>
          <p class="note">
            We have not yet confirmed which of these suit the {product.shortName}, and none has an approved price, so none can be selected here. Tell us what you would like and we will say what is possible.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 + 7. Planning, delivery & installation -->
  <section class="section is-surface" id="planning" aria-labelledby="planning-title">
    <div class="container grid-12">
      <div class="c-5">
        <p class="label muted">Planning</p>
        <h2 id="planning-title">Delivery &amp; installation</h2>
        <p class="lead">We check the space and access before confirming your installation.</p>
        <p style="margin-top: var(--s-5)"><a class="text-link" href="/installation-delivery">View installation guidance <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
      <div class="c-6 c-start-7 stack" style="--stack: var(--s-5)">
        <ol class="mini-steps">
          {stages.map((s) => <li><strong>{s.title}.</strong> <span class="muted">{s.body}</span></li>)}
        </ol>
        {leadTime && <p><span class="label muted">Lead time</span><br />{leadTime}</p>}
        {coverage && <p class="muted">{coverage}</p>}
      </div>
    </div>
  </section>

  <!-- 9. Real installations: only genuine, matching projects -->
  {
    projects.length > 0 && (
      <section class="section" aria-labelledby="projects-title">
        <div class="container">
          <h2 id="projects-title">{product.name} in real gardens</h2>
          <ul class="plain-list">{projects.map((p) => <li><a href={`/installations/${p.slug}`}>{p.title}</a></li>)}</ul>
        </div>
      </section>
    )
  }

  <!-- 8 + 10. Care & support, FAQs -->
  <section class="section" id="faqs" aria-labelledby="faq-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">Good to know</p>
        <h2 id="faq-title">Questions about the {product.shortName}</h2>
        <p class="muted" style="margin-top: var(--s-4)">
          After handover you have an accessible first point of contact for care questions. See <a href="/care-support">care &amp; support</a> and the <a href="/warranty">warranty</a> page.
        </p>
      </div>
      <div class="c-7 c-start-6">
        <FaqList items={relevantFaqs} openFirst />
      </div>
    </div>
  </section>

  <!-- 11. Compare another model -->
  <section class="section section--tight is-surface" aria-labelledby="compare-title">
    <div class="container">
      <h2 class="h2" id="compare-title">Compare another model</h2>
      <ul class="compare-links">
        {others.map((o) => {
          const op = publicProduct(o);
          return (
            <li>
              <a href={`/compare?m=${product.id},${o.id}`}>
                <span class="compare-links__t">The {product.shortName} and {o.name}</span>
                <span class="muted">{op.capacity ? `${op.capacity}` : 'See comparison'}{op.price ? ` · from ${op.price}` : ''}</span>
              </a>
            </li>
          );
        })}
        <li>
          <a href="/compare#selector"><span class="compare-links__t">Help me choose</span><span class="muted">Answer a few questions for a starting point</span></a>
        </li>
      </ul>
    </div>
  </section>

  <section class="closing is-forest is-forest-gradient" id="enquire" aria-labelledby="close-title" data-product-close>
    <div class="container closing__inner">
      <h2 class="display" id="close-title">Plan your {product.shortName}.</h2>
      <div class="closing__copy">
        <p class="lead">
          Tell us where you’re based and what you have in mind{cap ? `. We’ll help you check that the ${product.shortName}, with comfortable seating for ${capacityInWords(cap)}, suits your space` : ''}.
        </p>
        <a class="btn" href={`/plan-your-sauna?model=${product.id}`}>Plan your {product.shortName}</a>
      </div>
    </div>
  </section>

  <!-- Sticky enquiry bar (mobile) -->
  <div class="sticky-cta" data-sticky-cta hidden>
    <span class="sticky-cta__name serif">{product.name}</span>
    <a class="btn" href={`/plan-your-sauna?model=${product.id}`}>Plan your {product.shortName}</a>
  </div>
</Base>

<style is:global>
  .product-top { padding-top: clamp(0.5rem, 1.5vw, 1.25rem); padding-bottom: var(--section-tight); }
  .product-top__grid { align-items: start; }
  .product-top__panel { min-width: 0; }
  .product-top__sticky { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  .ppanel__lead { font-size: var(--fs-small); }
  .ppanel__summary { display: grid; gap: 0.15rem; }
  .ppanel__summary-text { font-weight: 600; }

  /* local navigation */
  .local-nav { position: sticky; top: var(--header-h); z-index: 80; background: var(--c-canvas); border-block: var(--border); }
  .local-nav ul { display: flex; gap: var(--s-5); overflow-x: auto; scrollbar-width: none; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
  .local-nav ul::-webkit-scrollbar { display: none; }
  .local-nav a { display: inline-flex; align-items: center; min-height: 48px; white-space: nowrap; text-decoration: none; font-size: var(--fs-small); font-weight: 600; color: var(--c-muted); border-bottom: 2px solid transparent; }
  .local-nav a:hover { color: var(--c-charcoal); }
  .local-nav a[aria-current='true'] { color: var(--c-charcoal); border-bottom-color: var(--c-ember); }
  section[id] { scroll-margin-top: calc(var(--header-h) + 3.5rem); }
  @media (min-width: 60rem) {
    .product-top__sticky { position: sticky; top: calc(var(--header-h) + 1.25rem); }
  }
  .ppanel { display: grid; gap: var(--s-4); padding-top: var(--s-4); border-top: var(--border); }
  .ppanel__fieldset { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: var(--s-3); }
  .ppanel__fieldset legend { padding: 0; margin-bottom: var(--s-2); }
  .ppanel__summary p { font-weight: 600; }
  .ppanel__note { font-size: var(--fs-small); color: var(--fg-muted); }
  .ppanel__heat { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .ppanel__heat-opt { position: relative; display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 0.95rem; border: 1px solid var(--c-muted); border-radius: var(--radius); background: var(--c-surface); cursor: pointer; font-size: 0.9375rem; font-weight: 600; }
  .ppanel__heat-opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .ppanel__heat-opt:has(input:checked) { background: var(--c-charcoal); color: var(--c-canvas); border-color: var(--c-charcoal); }
  .ppanel__heat-opt:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .ppanel__heat-opt.is-off { color: var(--c-muted); border-style: dashed; cursor: not-allowed; background: transparent; }
  .ppanel__heat-opt.is-off input { cursor: not-allowed; }
  .ppanel__heat-note { font-size: var(--fs-small); color: var(--c-muted); min-height: 1.4em; }

  .tick-list { display: grid; gap: var(--s-3); margin-block: var(--s-2); }
  .tick-list li { position: relative; padding-left: 1.5rem; color: var(--c-on-forest-muted); }
  .tick-list li::before { content: ''; position: absolute; left: 0; top: 0.7em; width: 0.75rem; height: 1px; background: var(--c-ember-on-forest); }

  .spec-groups { display: grid; gap: var(--s-7); }
  @media (min-width: 68.75rem) { .spec-groups { grid-template-columns: 1fr 1fr; gap: var(--s-6); align-items: start; } }
  .spec-groups h3 { margin-bottom: var(--s-3); }
  .choices { display: grid; border-top: var(--border); }
  .choices li { display: grid; grid-template-columns: 1fr auto; gap: 0.25rem var(--s-3); align-items: center; padding: 1rem 0; border-bottom: var(--border); }
  .choices li p { grid-column: 1 / -1; color: var(--fg-muted); max-width: 40em; }
  .choices li.is-off .choices__name { color: var(--fg-muted); }
  .choices__name { font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 340; }
  .mini-steps { display: grid; gap: var(--s-3); counter-reset: ms; }
  .mini-steps li { padding-bottom: var(--s-3); border-bottom: var(--border); }

  .compare-links { display: grid; gap: 0; margin-top: var(--s-5); border-top: var(--border); }
  .compare-links a { display: flex; flex-wrap: wrap; gap: 0.25rem var(--s-5); justify-content: space-between; align-items: baseline; padding: 1.1rem 0; border-bottom: var(--border); text-decoration: none; }
  .compare-links a:hover .compare-links__t { text-decoration: underline; text-underline-offset: 0.2em; }
  .compare-links__t { font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 340; }

  .sticky-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
    display: none; align-items: center; justify-content: space-between; gap: var(--s-3);
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--c-canvas); border-top: 1px solid var(--c-charcoal);
  }
  .sticky-cta__name { font-size: 1.25rem; }
  .sticky-cta .btn { min-height: 44px; padding-block: 0.5rem; }
  @media (max-width: 59.9375rem) {
    .sticky-cta.is-on { display: flex; }
    body.has-sticky-cta .site-footer { padding-bottom: 6rem; }
  }
</style>

<script>
  import { track } from '@/lib/analytics';
  // mark the section in view in the local navigation (links still work with no script)
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-local-nav] a')];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter(Boolean) as HTMLElement[];
  if (links.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          links.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === `#${(e.target as HTMLElement).id}`)));
        });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const top = document.querySelector<HTMLElement>('[data-product-top]');
  const close = document.querySelector<HTMLElement>('[data-product-close]');
  // the last path segment, ignoring a trailing slash or index.html (static bundles are served as files)
  const modelId = new URL(location.href).pathname.split('/').filter((x) => x && x !== 'index.html').pop() ?? '';
  track('view_product', { model_id: modelId });

  if (bar && top && 'IntersectionObserver' in window) {
    let topVisible = true;
    let closeVisible = false;
    const apply = () => {
      const on = !topVisible && !closeVisible;
      bar.hidden = !on;
      bar.classList.toggle('is-on', on);
    };
    new IntersectionObserver(([e]) => { topVisible = e.isIntersecting; apply(); }).observe(top);
    if (close) new IntersectionObserver(([e]) => { closeVisible = e.isIntersecting; apply(); }).observe(close);
  }
</script>
