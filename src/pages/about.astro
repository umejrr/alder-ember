---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { site } from '@/content/site';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Alder & Ember' }];
const controls = [
  ['The range', 'We decide which models, finishes and options we offer, and describe them honestly.'],
  ['Consultation', 'We help you choose a model and talk through heating and your space.'],
  ['Site assessment', 'We check your space and access before an order is confirmed.'],
  ['Installation coordination', 'We coordinate delivery and installation, and set out who does what.'],
  ['Quality checks', 'We check the installation before handover.'],
  ['Aftercare', 'You have an accessible first point of contact after handover.'],
];
---
<Base
  title="About Alder & Ember | Outdoor Saunas"
  description="Alder & Ember is a UK supplier and installer of premium outdoor saunas. Our core range is built by a specialist European manufacturing partner to agreed specifications."
  breadcrumbs={crumbs}
>
  <header class="page-head container">
    <Breadcrumbs items={crumbs} />
    <h1>About Alder &amp; Ember</h1>
    <p class="lead">{site.shortDescription} We are a small UK team that supplies and installs outdoor saunas.</p>
  </header>

  <section class="section section--flush-top" aria-labelledby="how-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">How it works</p>
        <h2 id="how-title">Who builds what</h2>
      </div>
      <div class="c-7 c-start-6 prose">
        <p>
          We work with a specialist European manufacturing partner, who builds our core range to agreed specifications. We do not build the saunas ourselves, and we do not present the manufacturer’s workshop as ours.
        </p>
        <p>
          What we do is look after everything around the sauna: the range and its approved finishes and options, helping you choose, checking your site, coordinating installation, checking quality, and being there afterwards.
        </p>
        <p>
          Bespoke changes need the manufacturer’s confirmation before we can quote or accept an order.
        </p>
      </div>
    </div>
  </section>

  <section class="section is-surface" aria-labelledby="control-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">What we look after</p>
        <h2 id="control-title">Where we take responsibility</h2>
      </div>
      <dl class="c-8 facts control-list">
        {controls.map(([t, d]) => <div><dt>{t}</dt><dd><span class="sub" style="color: inherit; font-weight: 500">{d}</span></dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="quality-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">Quality</p>
        <h2 id="quality-title">What we mean by quality</h2>
      </div>
      <div class="c-7 c-start-6 prose">
        <p>We try to explain quality through specifics. The core range uses thermally modified exterior timber, smooth sauna-grade interior timber and insulated cabin construction, with carefully finished benches and fittings. Glazing and heaters are selected for the specific configuration.</p>
        <p>We would rather tell you what needs checking than promise that everything will fit. That is why we assess the site before confirming an order.</p>
      </div>
    </div>
  </section>

  <section class="section is-surface" aria-labelledby="team-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">The team</p>
        <h2 id="team-title">A small team, with clear roles</h2>
      </div>
      <div class="c-7 c-start-6 prose">
        <p>We are seven people. Sales looks after your questions and enquiry. Operations confirms specifications, fulfilment and installation details. Marketing looks after what you read and see here, and the founder is responsible for the direction of the business.</p>
        <p class="muted">Profiles and photographs of the team will be added when they have been approved.</p>
      </div>
    </div>
  </section>

  <section class="closing is-forest is-forest-gradient" aria-labelledby="close-title">
    <div class="container closing__inner">
      <h2 class="display" id="close-title">Let’s plan a sauna that suits your space.</h2>
      <div class="closing__copy">
        <p class="lead">Tell us where you’re based and what you have in mind. We’ll help you choose the next step.</p>
        <a class="btn" href="/plan-your-sauna">Plan your sauna</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .control-list dt { font-weight: 700; color: var(--fg); font-size: var(--fs-body); }
  .control-list > div { grid-template-columns: minmax(10rem, 15rem) 1fr; }
</style>
