---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Picture from '@/components/Picture.astro';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About Alder & Ember' }];
const controls = [
  ['The range', 'We decide which models, finishes and options we offer, and describe each one plainly.'],
  ['Consultation', 'We help you choose a model and talk through heating and your space.'],
  ['Site assessment', 'We check your space and access before an order is confirmed.'],
  ['Installation', 'We coordinate delivery and installation, and set out who does what.'],
  ['Quality checks', 'We check the installation before handover.'],
  ['Aftercare', 'You have an accessible first point of contact after handover.'],
];
---
<Base
  title="About Alder & Ember | Outdoor Saunas"
  description="Alder & Ember is a UK supplier and installer of premium outdoor saunas. Our core range is built by a specialist European manufacturing partner to agreed specifications."
  breadcrumbs={crumbs}
>
  <header class="page-head container about-head">
    <Breadcrumbs items={crumbs} />
    <h1>About Alder &amp; Ember</h1>
    <p class="lead about-head__lead">
      We supply and install premium outdoor saunas for UK gardens. We help you choose, check your site, and look after the installation from first conversation to handover.
    </p>
  </header>

  <section class="section section--flush-top" aria-labelledby="how-title">
    <div class="container grid-12">
      <div class="c-5 side">
        <p class="label muted">How it works</p>
        <h2 id="how-title">Built by specialists, looked after by us.</h2>
      </div>
      <div class="c-6 c-start-7 prose">
        <p>
          Our core range is built to agreed specifications by a specialist European manufacturing partner.
        </p>
        <p>
          Alder &amp; Ember looks after everything around the sauna: the range and its approved finishes and options, helping you choose, checking your site, coordinating installation, quality checks and aftercare.
        </p>
        <p>
          Bespoke changes need the manufacturer’s confirmation before we can quote or accept an order.
        </p>
      </div>
    </div>
  </section>

  <section class="section is-surface" aria-labelledby="control-title">
    <div class="container">
      <div class="section-head">
        <p class="label muted">What we look after</p>
        <h2 id="control-title">Where we take responsibility</h2>
      </div>
      <ol class="about-grid">
        {controls.map(([t, d], i) => (
          <li>
            <span class="about-grid__n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="about-grid__t">{t}</h3>
            <p class="muted">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="quality-title">
    <div class="container grid-12">
      <div class="c-5 side">
        <p class="label muted">Quality</p>
        <h2 id="quality-title">Quality, in specifics</h2>
      </div>
      <div class="c-6 c-start-7 prose">
        <p>The core range uses thermally modified exterior timber, smooth sauna-grade interior timber and insulated cabin construction, with carefully finished benches and fittings. Glazing and heaters are selected for the specific configuration.</p>
        <p>We would rather tell you what needs checking than promise that everything will fit, which is why we assess the site before confirming an order.</p>
        <p><a class="text-link" href="/#find-your-fit">See the three models <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

  <section class="section is-surface" aria-labelledby="team-title">
    <div class="container grid-12">
      <div class="c-5 side">
        <p class="label muted">The team</p>
        <h2 id="team-title">A small team, with clear roles</h2>
      </div>
      <div class="c-6 c-start-7 prose">
        <p>We are seven people. Sales looks after your questions and enquiry. Operations confirms specifications, fulfilment and installation details. Marketing looks after what you read and see here, and the founder is responsible for the direction of the business.</p>
      </div>
    </div>
  </section>

  <section class="closing is-forest is-forest-gradient" aria-labelledby="close-title">
    <div class="container closing__inner">
      <div class="closing__text">
        <h2 class="display" id="close-title">Let’s plan your sauna.</h2>
        <p class="lead">Tell us where you’re based and what you have in mind. We’ll help you choose the next step.</p>
        <a class="btn" href="/plan-your-sauna">Plan your sauna</a>
      </div>
      <div class="closing__media"><Picture id="alder-detail" sizes="(min-width: 60rem) 44vw, 100vw" /></div>
    </div>
  </section>
</Base>

<style is:global>
  .about-head__lead { max-width: 34em; }
  .about-grid { display: grid; gap: 0; border-top: var(--border); margin-top: var(--sp-2); }
  .about-grid li { display: grid; gap: var(--sp-05); padding: var(--sp-2) 0; border-bottom: var(--border); align-content: start; }
  .about-grid__n { font-size: var(--fs-small); font-weight: 700; letter-spacing: 0.06em; color: var(--c-timber); }
  .about-grid__t { font-size: var(--fs-h3); }
  @media (min-width: 47.5rem) {
    .about-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--sp-3); }
  }
  @media (min-width: 68.75rem) {
    .about-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
