---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { visibleGuides } from '@/lib/visibility';
import { isPreview } from '@/lib/mode';
import type { Guide } from '@/content/types';

export function getStaticPaths() {
  return visibleGuides().map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}
const { guide } = Astro.props as { guide: Guide };
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Planning guides', href: '/guides' }, { label: guide.title }];
const unapproved = guide.approval !== 'approved';
---
<Base
  title={`${guide.title} | Alder & Ember`}
  description={guide.summary}
  breadcrumbs={crumbs}
  noindex={unapproved}
>
  <header class="page-head container">
    <Breadcrumbs items={crumbs} />
    <p class="label muted">{guide.topic}</p>
    <h1>{guide.title}</h1>
    <p class="lead">{guide.intro}</p>
    {isPreview() && unapproved && <p class="alert alert--info" role="note" style="max-width: 40rem; margin-top: var(--s-5)">Draft: awaiting expert approval. Not published in production builds.</p>}
  </header>

  <article class="section section--flush-top">
    <div class="container grid-12">
      <div class="c-8 c-start-2 prose guide-body">
        {guide.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.body.map((p) => <p>{p}</p>)}
            {s.list && <ul>{s.list.map((l) => <li>{l}</li>)}</ul>}
          </section>
        ))}
      </div>
    </div>
  </article>

  <section class="section section--tight is-surface" aria-labelledby="next-title">
    <div class="container grid-12">
      <div class="c-8 c-start-2">
        <h2 class="h3" id="next-title">Where next</h2>
        <ul class="plain-list" style="margin-top: var(--s-4)">
          {guide.relatedLinks.map((l) => <li><a class="text-link" href={l.href}>{l.label} <span class="arrow" aria-hidden="true">→</span></a></li>)}
          <li><a class="text-link" href="/plan-your-sauna">Plan your sauna <span class="arrow" aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .guide-body section + section { margin-top: var(--s-7); }
  .guide-body h2 { font-size: var(--fs-h3); margin-top: 0; }
  .guide-body section > * + * { margin-top: var(--s-3); }
</style>
