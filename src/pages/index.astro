---
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import FaqList from '@/components/FaqList.astro';
import FindYourFit from '@/components/react/FindYourFit';
import { productList } from '@/content/products';
import { stages } from '@/content/site';
import { faqs, homeFaqIds } from '@/content/faqs';
import { toModelView } from '@/lib/model-view';
import { installationsRouteEnabled, visibleInstallations } from '@/lib/visibility';
import { isPreview } from '@/lib/mode';

const models = productList.map((p) => toModelView(p));
const homeFaqs = homeFaqIds.map((id) => faqs.find((f) => f.id === id)!);
const featured = visibleInstallations()[0];
const showInstallations = installationsRouteEnabled();

const details = [
  { title: 'Thermally modified exterior timber', body: 'The outside of every cabin is clad in thermally modified timber.' },
  { title: 'Smooth sauna-grade interior timber', body: 'Smooth, sauna-grade timber lines the inside of the cabin.' },
  { title: 'Insulated cabin construction', body: 'An insulated cabin, built by our European manufacturing partner to agreed specifications.' },
  { title: 'Glazing and heaters selected for you', body: 'Glazing and heaters are chosen for your specific configuration, and confirmed in your quotation.' },
];
---
<Base
  title="Premium Outdoor Saunas | Alder & Ember"
  description="Premium outdoor saunas for UK gardens, planned around your space. Compare three models, see starting prices, and understand how site assessment and installation work."
  overHero
>
  <!-- A. Atmosphere: one large image, a short offer -->
  <section class="hero is-forest" data-hero aria-labelledby="hero-title">
    <div class="hero__media">
      <Picture id="hero-wide" priority fill class="hero__pic hero__pic--wide" quiet />
      <Picture id="hero-mobile" priority fill class="hero__pic hero__pic--narrow" quiet />
      <div class="hero__scrim" aria-hidden="true"></div>
      {isPreview() && <span class="hero__tag chip">Preview image · hero photograph to be supplied</span>}
    </div>
    <div class="container hero__copy">
      <h1 class="display" id="hero-title">Premium outdoor saunas, planned around your space.</h1>
      <p class="lead">
        Explore a considered range of garden saunas, with practical advice, site assessment, and installation coordinated with care.
      </p>
      <div class="actions">
        <a class="btn" href="#find-your-fit">Explore the saunas</a>
        <a class="btn btn--secondary" href="/plan-your-sauna">Plan your sauna</a>
      </div>
    </div>
  </section>

  <!-- Bridge: what is on offer, in one breath -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container grid-12">
      <div class="c-8">
        <p class="label muted">Three garden saunas</p>
        <h2 id="intro-title" class="intro__statement reveal">
          Three garden saunas, with help choosing between them, a check of your space and access, and installation coordinated for you.
        </h2>
      </div>
      <div class="c-4 intro__aside reveal">
        <p>
          Each model has a comfortable capacity, a working size and a starting price. We confirm the model and the site requirements with you before your order is confirmed.
        </p>
        <a class="text-link" href="/installation-delivery">How installation works <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- C. Choice: Find your fit -->
  <section class="section section--flush-top" id="find-your-fit" aria-labelledby="fyf-title">
    <div>
      <div class="container section-head">
        <p class="label">The collection</p>
        <h2 id="fyf-title">Find your fit</h2>
        <p class="lead muted">Choose a model to see who it suits, how many adults it seats comfortably, and where prices start.</p>
      </div>
      <div class="container">
        <FindYourFit client:visible models={models} initial="alder" />
        <div class="fyf-after">
          <ul class="fyf-links" aria-label="All models">
            {productList.map((p) => <li><a class="text-link" href={`/saunas/${p.slug}`}>{p.name} <span class="arrow" aria-hidden="true">→</span></a></li>)}
          </ul>
          <a class="btn btn--secondary" href="/compare">Compare the three models</a>
        </div>
      </div>
    </div>
  </section>

  <!-- D. Understanding: considered in every detail (dark chapter) -->
  <section class="chapter is-forest is-forest-gradient" aria-labelledby="detail-title">
    <div class="container grid-12 chapter__grid">
      <div class="c-6 chapter__media reveal">
        <Picture id="detail-timber" class="chapter__main" sizes="(min-width: 960px) 46vw, 100vw" />
        <Picture id="detail-interior-finish" class="chapter__inset" sizes="(min-width: 960px) 24vw, 60vw" />
      </div>
      <div class="c-5 c-start-8 chapter__copy">
        <p class="label">Materials and construction</p>
        <h2 id="detail-title">Considered in every detail.</h2>
        <p class="lead">
          The details that matter in a sauna are practical ones. These are the ones we can stand behind, and we will say plainly where a detail depends on the configuration you choose.
        </p>
        <ol class="detail-list">
          {details.map((d, i) => (
            <li>
              <span class="detail-list__n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="detail-list__t">{d.title}</h3>
                <p>{d.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <a class="btn btn--secondary" href="/compare">Compare models</a>
      </div>
    </div>
  </section>

  <!-- E. From your space to first use -->
  <section class="section" aria-labelledby="process-title">
    <div class="container grid-12">
      <div class="c-5 process__intro">
        <p class="label muted">Installation</p>
        <h2 id="process-title">From your space to first use</h2>
        <p class="lead">We check the space and access before confirming your installation.</p>
        <Picture id="site-access" class="process__pic" sizes="(min-width: 960px) 38vw, 100vw" />
        <a class="text-link" href="/installation-delivery">View installation guidance <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="c-6 c-start-7 steps">
        {stages.map((s) => (
          <li class="steps__item reveal">
            <span class="steps__n serif tnum" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
            <div>
              <h3 class="steps__t"><span class="sr-only">Step {s.n}: </span>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- F. Evidence: real installations only -->
  {
    showInstallations && (
      <section class="section is-surface" aria-labelledby="installs-title">
        <div class="container">
          <div class="section-head">
            <p class="label muted">Our installations</p>
            <h2 id="installs-title">Our installations</h2>
          </div>
          {featured ? (
            <p>{featured.title}</p>
          ) : (
            <div class="empty-state" role="note">
              <div class="empty-state__pic"><Picture id="installation-process" quiet /></div>
              <div class="empty-state__copy">
                <span class="chip">Preview layout</span>
                <h3>Installation stories will appear here.</h3>
                <p>
                  Each story will show a genuine completed project: the model, the general region, the site challenge and approved photography. None has been supplied yet, so nothing is shown, and this section is left out of production builds until it has real content.
                </p>
                <a class="text-link" href="/installations">See the story layout <span class="arrow" aria-hidden="true">→</span></a>
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- G. A model for your space (compact) -->
  <section class="section section--tight decide" aria-labelledby="decide-title">
    <div class="container decide__inner">
      <div>
        <h2 id="decide-title" class="h2">Still deciding?</h2>
        <p class="lead muted">Compare the three side by side, or answer a few questions for a shortlist. Either way, we will confirm the model and site requirements with you.</p>
      </div>
      <div class="actions">
        <a class="btn" href="/compare">Compare models</a>
        <a class="btn btn--secondary" href="/compare#selector">Help me choose</a>
      </div>
    </div>
  </section>

  <!-- H. Planning questions -->
  <section class="section is-surface" aria-labelledby="faq-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">Planning questions</p>
        <h2 id="faq-title">Before you enquire</h2>
        <p class="muted" style="margin-top: var(--s-4)">The questions people ask most about base, access and price.</p>
        <p style="margin-top: var(--s-5)"><a class="text-link" href="/installation-delivery">View installation guidance <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
      <div class="c-7 c-start-6">
        <FaqList items={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- I. Commercial invitation -->
  <section class="section section--tight commercial" aria-labelledby="commercial-title">
    <div class="container commercial__inner">
      <div>
        <p class="label muted">Commercial projects</p>
        <h2 id="commercial-title" class="h2">A sauna for guests or clients?</h2>
      </div>
      <div class="commercial__copy">
        <p>
          Boutique stays, small hotels and appointment-based wellness venues are assessed individually. We look at how the sauna will be used, maintained and operated before recommending a starting point.
        </p>
        <a class="btn btn--secondary" href="/commercial">Discuss a commercial project</a>
      </div>
    </div>
  </section>

  <!-- J. Action -->
  <section class="closing is-forest is-forest-gradient" aria-labelledby="closing-title">
    <div class="container closing__inner">
      <h2 class="display" id="closing-title">Let’s plan a sauna that suits your space.</h2>
      <div class="closing__copy">
        <p class="lead">Tell us where you’re based and what you have in mind. We’ll help you choose the next step.</p>
        <a class="btn" href="/plan-your-sauna">Plan your sauna</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: grid;
    min-height: min(92svh, 58rem);
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__pic { position: absolute; inset: 0; }
  .hero__pic--narrow { display: none; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(10, 16, 12, 0.82) 0%, rgba(10, 16, 12, 0.5) 32%, rgba(10, 16, 12, 0) 62%),
      linear-gradient(90deg, rgba(10, 16, 12, 0.45) 0%, rgba(10, 16, 12, 0) 58%);
  }
  .hero__tag {
    position: absolute;
    right: var(--gutter);
    bottom: 1.25rem;
    color: var(--c-on-forest);
    background: rgba(10, 16, 12, 0.35);
    font-size: 0.6875rem;
  }
  .hero__copy {
    align-self: end;
    display: grid;
    gap: var(--s-5);
    padding-top: calc(var(--header-h) + 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__copy .display { max-width: 15ch; }
  .hero__copy .lead { color: var(--c-on-forest); max-width: 34em; }
  .hero .btn--secondary { --btn-border: rgba(244, 240, 232, 0.7); }

  @media (max-width: 640px) {
    /* image first, then copy on a deep forest panel: legibility never depends on the photo */
    .hero {
      min-height: 0;
      grid-template-rows: min(64svh, 30rem) auto;
    }
    .hero__media { position: relative; grid-row: 1; }
    .hero__pic--wide { display: none; }
    .hero__pic--narrow { display: block; }
    .hero__scrim {
      background: linear-gradient(0deg, rgba(17, 28, 22, 1) 0%, rgba(17, 28, 22, 0) 38%);
    }
    .hero__tag { left: var(--gutter); right: auto; top: calc(var(--header-h) + 0.75rem); bottom: auto; }
    .hero__copy {
      grid-row: 2;
      background: var(--c-forest);
      width: 100%;
      padding: 0 var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom));
      margin: 0;
      padding-top: var(--s-5);
    }
  }

  /* ---------- intro ---------- */
  .intro { padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(3rem, 2rem + 4vw, 5.5rem); }
  .intro__statement {
    margin-top: var(--s-4);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    line-height: 1.18;
    font-weight: 300;
    max-width: 22em;
  }
  .intro__aside { display: grid; gap: var(--s-4); align-content: end; color: var(--c-muted); }
  .intro__aside .text-link { color: var(--c-charcoal); justify-self: start; }

  /* ---------- find your fit ---------- */
  .fyf-after {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--s-5);
  }
  .fyf-links { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); }

  /* ---------- dark chapter ---------- */
  .chapter { padding-block: var(--section); }
  .chapter__grid { align-items: end; row-gap: var(--s-7); }
  .chapter__media { position: relative; padding-bottom: clamp(2rem, 8vw, 6rem); }
  .chapter__main { width: 100%; --ratio: 4 / 5; }
  .chapter__inset {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 52%;
    border: clamp(6px, 1vw, 10px) solid var(--c-forest-raised);
    box-sizing: content-box;
  }
  @media (max-width: 959px) {
    .chapter__media { padding-bottom: 0; display: grid; gap: var(--s-3); }
    .chapter__inset { position: static; width: 100%; border: 0; box-sizing: border-box; }
  }
  @media (min-width: 960px) {
    .chapter__inset { right: -12%; width: 56%; }
  }
  .chapter__copy { display: grid; gap: var(--s-5); align-content: end; }
  .chapter__copy .lead { color: var(--c-on-forest-muted); font-size: var(--fs-body); }
  .detail-list { display: grid; border-top: 1px solid var(--rule); }
  .detail-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--s-3);
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .detail-list__n { font-size: var(--fs-small); color: var(--c-ember-on-forest); font-weight: 700; padding-top: 0.3rem; }
  .detail-list__t { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; letter-spacing: 0; line-height: 1.35; }
  .detail-list p { color: var(--c-on-forest-muted); font-size: var(--fs-small); margin-top: 0.2rem; }
  .chapter__copy .btn { justify-self: start; }

  /* ---------- process ---------- */
  .process__intro { display: grid; gap: var(--s-4); align-content: start; }
  .process__pic { margin-block: var(--s-4); }
  .steps { display: grid; counter-reset: step; }
  .steps__item {
    display: grid;
    grid-template-columns: clamp(3rem, 6vw, 5rem) 1fr;
    gap: var(--s-4);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-top: var(--border);
  }
  .steps__item:last-child { border-bottom: var(--border); }
  .steps__n { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); font-weight: 250; line-height: 1; color: var(--c-timber); }
  .steps__t { font-size: var(--fs-h3); margin-bottom: 0.4rem; }

  /* ---------- installations preview ---------- */
  .empty-state {
    display: grid;
    gap: var(--s-6);
    border: 1px dashed var(--c-muted);
    padding: clamp(1rem, 3vw, 2rem);
  }
  .empty-state__copy { display: grid; gap: var(--s-3); align-content: center; max-width: 36rem; }
  .empty-state__copy h3 { font-size: var(--fs-h3); }
  .empty-state__copy .text-link { justify-self: start; }
  @media (min-width: 900px) {
    .empty-state { grid-template-columns: 1.2fr 1fr; align-items: center; }
  }

  /* ---------- decide / commercial ---------- */
  .decide { border-top: var(--border); }
  .decide__inner, .commercial__inner {
    display: grid;
    gap: var(--s-5);
    align-items: end;
  }
  .commercial__copy { display: grid; gap: var(--s-4); }
  .commercial__copy .btn { justify-self: start; }
  @media (min-width: 900px) {
    .decide__inner { grid-template-columns: 1.3fr auto; }
    .commercial__inner { grid-template-columns: 1fr 1fr; align-items: start; gap: var(--s-8); }
  }

  /* ---------- closing ---------- */
  .closing { padding-block: clamp(5rem, 3rem + 10vw, 11rem); border-bottom: 1px solid var(--rule); }
  .closing__inner { display: grid; gap: var(--s-6); }
  .closing .display { max-width: 14ch; }
  .closing__copy { display: grid; gap: var(--s-5); max-width: 30rem; }
  .closing__copy .lead { color: var(--c-on-forest-muted); }
  .closing__copy .btn { justify-self: start; }
  @media (min-width: 960px) {
    .closing__inner { grid-template-columns: 1.25fr 1fr; align-items: end; gap: var(--s-8); }
  }
</style>
