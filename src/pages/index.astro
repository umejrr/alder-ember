---
import Base from '@/layouts/Base.astro';
import Picture from '@/components/Picture.astro';
import FaqList from '@/components/FaqList.astro';
import FindYourFit from '@/components/react/FindYourFit';
import { productList } from '@/content/products';
import { stages } from '@/content/site';
import { faqs, homeFaqIds } from '@/content/faqs';
import { toModelView } from '@/lib/model-view';
import { installationsRouteEnabled, visibleInstallations } from '@/lib/visibility';
import { isPreview } from '@/lib/mode';
import { getAsset } from '@/content/assets';

const heroTag = getAsset('hero-wide')?.kind === 'stock-preview' ? 'Stock preview photo · to be replaced with your own' : 'Preview image · hero photograph to be supplied';

const models = productList.map((p) => toModelView(p));
const homeFaqs = homeFaqIds.map((id) => faqs.find((f) => f.id === id)!);
const featured = visibleInstallations()[0];
const showInstallations = installationsRouteEnabled();

// Three editorial details, each tied to an image and to wording already approved in the brief.
const details = [
  { id: 'exterior', label: 'Exterior', asset: 'detail-timber', title: 'Thermally modified timber, outside', body: 'The outside of every cabin is clad in thermally modified timber.' },
  { id: 'interior', label: 'Interior', asset: 'detail-interior-finish', title: 'Sauna-grade timber, inside', body: 'Smooth, sauna-grade timber lines the inside, with carefully finished benches and fittings.' },
  { id: 'build', label: 'Construction', asset: 'detail-construction', title: 'Insulated, built to specification', body: 'An insulated cabin, built by our European manufacturing partner to agreed specifications. Bespoke changes need the manufacturer’s confirmation before we quote.' },
];
---
<Base
  title="Premium Outdoor Saunas | Alder & Ember"
  description="Premium outdoor saunas for UK gardens, planned around your space. Compare three models, see starting prices, and understand how site assessment and installation work."
  overHero
  preloadFonts
>
  <!-- Arrive: one large image, a short offer -->
  <section class="hero is-forest" data-hero aria-labelledby="hero-title">
    <div class="hero__media">
      <Picture id="hero-wide" priority fill class="hero__pic hero__pic--wide" quiet />
      <Picture id="hero-mobile" priority fill class="hero__pic hero__pic--narrow" quiet />
      <div class="hero__scrim" aria-hidden="true"></div>
      {isPreview() && <span class="hero__tag chip">{heroTag}</span>}
    </div>
    <div class="container hero__copy">
      <h1 id="hero-title">
        <span class="hero__kicker">Premium outdoor saunas</span>
        <span class="display hero__headline">A quieter moment, just outside.</span>
      </h1>
      <p class="lead">
        Planned around your space and installed with care. Three models, with help choosing and installation coordinated for you.
      </p>
      <div class="actions">
        <a class="btn" href="#find-your-fit">Explore the saunas</a>
        <a class="btn btn--secondary" href="/plan-your-sauna">Plan your sauna</a>
      </div>
    </div>
  </section>

  <!-- Bridge: the offer in one breath -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container grid-12">
      <div class="c-7">
        <p class="label muted">The collection</p>
        <h2 id="intro-title" class="intro__statement reveal">Three models. Space to choose.</h2>
      </div>
      <div class="c-4 c-start-9 intro__aside reveal">
        <p>
          Choose by comfortable capacity and how you will use it. We then check your space and access, and coordinate the installation.
        </p>
        <a class="text-link" href="/installation-delivery">How installation works <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Choose: the model explorer -->
  <section class="section section--flush-top" id="find-your-fit" aria-labelledby="fyf-title">
    <div class="container">
      <h2 id="fyf-title" class="sr-only">Find your fit</h2>
      <FindYourFit client:visible models={models} initial="alder" />
      <div class="fyf-after">
        <p class="fyf-after__q">Still deciding?</p>
        <ul class="fyf-links" aria-label="Help choosing">
          <li><a class="text-link" href="/compare">Compare the three <span class="arrow" aria-hidden="true">→</span></a></li>
          <li><a class="text-link" href="/compare#selector">Help me choose <span class="arrow" aria-hidden="true">→</span></a></li>
        </ul>
        <ul class="fyf-links fyf-links--all" aria-label="All models">
          {productList.map((p) => <li><a class="text-link" href={`/saunas/${p.slug}`}>{p.name}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Inspect: materials, one detail at a time -->
  <section class="materials is-forest is-forest-gradient" aria-labelledby="detail-title" data-materials>
    <div class="container">
      <div class="materials__head">
        <p class="label">Materials and construction</p>
        <h2 id="detail-title">Considered in every detail.</h2>
        <p class="lead">Timber outside and in, an insulated build, and glazing and heaters chosen for your configuration.</p>
      </div>
      <div class="materials__body">
        <div class="materials__stage">
          <div class="materials__tabs" role="group" aria-label="Choose a detail">
            {details.map((d) => <button type="button" class="materials__tab" data-detail-btn={d.id} aria-pressed="false">{d.label}</button>)}
          </div>
          <div class="materials__frames">
            {details.map((d) => (
              <div class="materials__frame" data-frame={d.id}>
                <Picture id={d.asset} fill sizes="(min-width: 60rem) 50vw, 100vw" />
              </div>
            ))}
          </div>
        </div>
        <ol class="materials__list">
          {details.map((d, i) => (
            <li class="material" data-detail={d.id}>
              <div class="material__pic"><Picture id={d.asset} sizes="(min-width: 40rem) 70vw, 100vw" /></div>
              <p class="material__n tnum" aria-hidden="true">{String(i + 1).padStart(2, '0')} · {d.label}</p>
              <h3 class="material__t">{d.title}</h3>
              <p class="material__b">{d.body}</p>
            </li>
          ))}
        </ol>
      </div>
      <p class="materials__foot">Glazing and heaters are selected for the configuration you choose, and confirmed in your quotation.</p>
    </div>
  </section>

  <!-- Understand: from your space to first use -->
  <section class="section plan" aria-labelledby="process-title" data-plan>
    <div class="container grid-12">
      <div class="c-5 process__intro">
        <p class="label muted">Installation</p>
        <h2 id="process-title">From your space to first use</h2>
        <p class="lead">We check the space and access before confirming your installation.</p>
        <Picture id="site-access" class="process__pic" sizes="(min-width: 60rem) 38vw, 100vw" />
        <div class="process__split">
          <p><strong>We coordinate</strong> the assessment, specification, delivery and installation checks.</p>
          <p><strong>Ground preparation and electrical connection</strong> are assessed separately, and may need your own contractor.</p>
        </div>
        <a class="text-link" href="/installation-delivery#responsibilities">Who does what <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="c-6 c-start-7 steps">
        {stages.map((s, i) => (
          <li class="steps__item" data-step={i}>
            <span class="steps__n serif tnum" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
            <div>
              <h3 class="steps__t"><span class="sr-only">Step {s.n}: </span>{s.title}</h3>
              <p class="muted">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Proof: real installations only (a compact note in preview; left out of production until real) -->
  {
    showInstallations && (
      <section class="section section--tight proof" aria-labelledby="installs-title">
        <div class="container">
          {featured ? (
            <>
              <h2 id="installs-title" class="h2">Our installations</h2>
              <p>{featured.title}</p>
            </>
          ) : (
            <div class="proof__note" role="note">
              <span class="chip">Preview</span>
              <h2 id="installs-title" class="proof__title">Installation stories</h2>
              <p>Genuine completed projects will appear here once photographed and approved. This section is left out of production until then.</p>
              <a class="text-link" href="/installations">See the story layout <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- Questions -->
  <section class="section is-surface" aria-labelledby="faq-title">
    <div class="container grid-12">
      <div class="c-4">
        <p class="label muted">Planning questions</p>
        <h2 id="faq-title">Before you enquire</h2>
        <p class="muted" style="margin-top: var(--s-4)">The questions people ask most about base, access and price.</p>
        <p style="margin-top: var(--s-5)"><a class="text-link" href="/installation-delivery">View installation guidance <span class="arrow" aria-hidden="true">→</span></a></p>
      </div>
      <div class="c-7 c-start-6">
        <FaqList items={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- Commercial invitation -->
  <section class="section section--tight commercial" aria-labelledby="commercial-title">
    <div class="container commercial__inner">
      <div>
        <p class="label muted">Commercial projects</p>
        <h2 id="commercial-title" class="h2">A sauna for guests or clients?</h2>
      </div>
      <div class="commercial__copy">
        <p>
          Boutique stays, small hotels and appointment-based wellness venues are assessed individually. We look at how the sauna will be used, maintained and operated before recommending a starting point.
        </p>
        <a class="btn btn--secondary" href="/commercial">Discuss a commercial project</a>
      </div>
    </div>
  </section>

  <!-- Begin -->
  <section class="closing is-forest is-forest-gradient" aria-labelledby="closing-title">
    <div class="container closing__inner">
      <div class="closing__text">
        <h2 class="display" id="closing-title">Let’s plan your sauna.</h2>
        <p class="lead">Tell us where you’re based and what you have in mind. We’ll help you choose the next step.</p>
        <a class="btn" href="/plan-your-sauna">Plan your sauna</a>
      </div>
      <div class="closing__media"><Picture id="closing-warmth" sizes="(min-width: 60rem) 44vw, 100vw" /></div>
    </div>
  </section>
</Base>

<script>
  // Materials: native scroll updates the sticky stage, and the visible buttons do the same job.
  // Everything here only enhances: without it the details read as a linear image/text sequence.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mat = document.querySelector<HTMLElement>('[data-materials]');
  if (mat) {
    const items = [...mat.querySelectorAll<HTMLElement>('[data-detail]')];
    const frames = [...mat.querySelectorAll<HTMLElement>('[data-frame]')];
    const btns = [...mat.querySelectorAll<HTMLButtonElement>('[data-detail-btn]')];
    const set = (id: string) => {
      frames.forEach((f) => f.classList.toggle('is-on', f.dataset.frame === id));
      items.forEach((i) => i.classList.toggle('is-active', i.dataset.detail === id));
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.detailBtn === id)));
    };
    set(items[0].dataset.detail!);
    mat.classList.add('is-enhanced');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.detailBtn!;
        set(id);
        items.find((i) => i.dataset.detail === id)?.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
      }),
    );
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && set((e.target as HTMLElement).dataset.detail!)),
        { rootMargin: '-40% 0px -45% 0px' },
      );
      items.forEach((i) => io.observe(i));
    }
  }

  // Planning: the stage in view is marked, and clicking a stage marks it too.
  const plan = document.querySelector<HTMLElement>('[data-plan]');
  if (plan) {
    const steps = [...plan.querySelectorAll<HTMLElement>('[data-step]')];
    const list = plan.querySelector<HTMLElement>('.steps');
    const mark = (n: number) => {
      steps.forEach((s, i) => s.classList.toggle('is-active', i === n));
      list?.style.setProperty('--progress', String((n + 1) / steps.length));
    };
    mark(0);
    plan.classList.add('is-enhanced');
    steps.forEach((s, i) => s.addEventListener('click', () => mark(i)));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => e.isIntersecting && mark(Number((e.target as HTMLElement).dataset.step))),
        { rootMargin: '-35% 0px -50% 0px' },
      );
      steps.forEach((s) => io.observe(s));
    }
  }
</script>

<style is:global>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    display: grid;
    min-height: min(92svh, 58rem);
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__pic { position: absolute; inset: 0; }
  .hero__pic--narrow { display: none; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 14% 78%, rgba(10, 16, 12, 0.62) 0%, rgba(10, 16, 12, 0) 72%),
      linear-gradient(0deg, rgba(10, 16, 12, 0.78) 0%, rgba(10, 16, 12, 0.4) 30%, rgba(10, 16, 12, 0) 58%),
      linear-gradient(90deg, rgba(10, 16, 12, 0.5) 0%, rgba(10, 16, 12, 0.22) 34%, rgba(10, 16, 12, 0) 56%);
  }
  .hero__tag {
    position: absolute;
    right: var(--gutter);
    bottom: 1.25rem;
    color: var(--c-on-forest);
    background: rgba(10, 16, 12, 0.35);
    font-size: 0.6875rem;
  }
  .hero__copy {
    align-self: end;
    display: grid;
    gap: var(--s-5);
    padding-top: calc(var(--header-h) + 6rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__copy h1 { display: grid; gap: var(--s-3); }
  .hero__kicker {
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-on-forest);
  }
  .hero__kicker::before {
    content: '';
    display: inline-block;
    width: 2rem;
    height: 1px;
    margin-right: 0.75rem;
    vertical-align: middle;
    background: var(--c-ember-on-forest);
  }
  /* sized so the headline ends before the cabin's doorway in the photograph (never across the door) */
  .hero__headline { max-width: 13ch; font-size: clamp(2.375rem, 1.1rem + 3.9vw, 4.25rem); }
  .hero__copy .lead { color: var(--c-on-forest); max-width: 28em; }
  .hero .btn--secondary { --btn-border: rgba(244, 240, 232, 0.7); }
  /* a short entrance for the copy only: the photograph is there immediately and the actions are reachable throughout */
  @keyframes hero-in { from { opacity: 0; transform: translateY(12px); } }
  .hero__copy > * { animation: hero-in 620ms var(--ease) both; }
  .hero__copy > :nth-child(2) { animation-delay: 70ms; }
  .hero__copy > :nth-child(3) { animation-delay: 140ms; }

  @media (max-width: 40rem) {
    /* image first, then copy on a deep forest panel: legibility never depends on the photo */
    .hero {
      min-height: 0;
      grid-template-rows: min(64svh, 30rem) auto;
    }
    .hero__media { position: relative; grid-row: 1; }
    .hero__pic--wide { display: none; }
    .hero__pic--narrow { display: block; }
    .hero__scrim {
      background: linear-gradient(0deg, rgba(17, 28, 22, 1) 0%, rgba(17, 28, 22, 0) 38%);
    }
    .hero__tag { left: var(--gutter); right: auto; top: calc(var(--header-h) + 0.75rem); bottom: auto; }
    .hero__copy {
      grid-row: 2;
      background: var(--c-forest);
      width: 100%;
      padding: 0 var(--gutter) calc(var(--s-7) + env(safe-area-inset-bottom));
      margin: 0;
      padding-top: var(--s-5);
    }
  }

  /* ---------- bridge ---------- */
  .intro { padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(2.5rem, 1.5rem + 3vw, 4rem); }
  .intro__statement {
    margin-top: var(--s-4);
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.25rem);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.015em;
    max-width: 12em;
  }
  .intro__aside { display: grid; gap: var(--s-4); align-content: end; color: var(--c-muted); }
  .intro__aside .text-link { color: var(--c-charcoal); justify-self: start; }

  /* ---------- model explorer surround ---------- */
  .fyf-after {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    align-items: baseline;
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: var(--border);
  }
  .fyf-after__q { font-family: var(--font-serif); font-size: var(--fs-h3); font-weight: 340; }
  .fyf-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .fyf-links--all { margin-left: auto; }
  .fyf-links--all .text-link { color: var(--c-muted); }

  /* ---------- materials ---------- */
  .materials { padding-block: var(--section); }
  .materials__head { display: grid; gap: var(--s-4); max-width: 40rem; margin-bottom: var(--s-8); }
  .materials__head .lead { color: var(--c-on-forest-muted); font-size: var(--fs-body); }
  .materials__body { display: grid; gap: var(--s-8); }
  .materials__stage { display: none; }
  .materials__list { display: grid; gap: var(--s-8); }
  .material { display: grid; gap: var(--s-3); max-width: 34rem; }
  .material__pic { margin-bottom: var(--s-3); }
  .material__n { font-size: var(--fs-small); font-weight: 700; letter-spacing: 0.06em; color: var(--c-ember-on-forest); }
  .material__t { font-size: var(--fs-h3); }
  .material__b { color: var(--c-on-forest-muted); }
  .materials__foot { margin-top: var(--s-8); max-width: 34rem; color: var(--c-on-forest-muted); font-size: var(--fs-small); border-top: 1px solid var(--rule); padding-top: var(--s-4); }

  /* wide screens, with scripting: one sticky stage that follows native scroll, plus equivalent buttons */
  @media (min-width: 60rem) {
    .materials.is-enhanced .materials__body {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: clamp(3rem, 6vw, 7rem);
      align-items: start;
    }
    .materials.is-enhanced .materials__stage {
      display: grid;
      gap: var(--s-4);
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
    .materials__tabs { display: flex; gap: var(--s-2); flex-wrap: wrap; }
    .materials__tab {
      min-height: 44px;
      padding: 0.5rem 1.1rem;
      background: transparent;
      color: var(--c-on-forest);
      border: 1px solid rgba(244, 240, 232, 0.4);
      border-radius: var(--radius);
      font-weight: 600;
      font-size: 0.9375rem;
      cursor: pointer;
      transition: background-color var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
    }
    .materials__tab:hover { border-color: var(--c-on-forest); }
    .materials__tab[aria-pressed='true'] { background: var(--c-on-forest); color: var(--c-forest); border-color: var(--c-on-forest); }
    .materials__frames {
      position: relative;
      aspect-ratio: 5 / 4;
      max-height: calc(100svh - var(--header-h) - 9rem);
      width: 100%;
      overflow: hidden;
      background: var(--c-forest-raised);
    }
    .materials__frame { position: absolute; inset: 0; opacity: 0; transition: opacity 420ms var(--ease); }
    .materials__frame.is-on { opacity: 1; }
    .materials.is-enhanced .material__pic { display: none; }
    .materials.is-enhanced .materials__list { gap: 0; }
    .materials.is-enhanced .material {
      min-height: 46svh;
      align-content: center;
      padding-block: var(--s-6);
      border-top: 1px solid var(--rule);
      transition: opacity 320ms var(--ease);
    }
    .materials.is-enhanced .material:not(.is-active) { opacity: 0.62; }
    .materials.is-enhanced .material:last-child { border-bottom: 1px solid var(--rule); }
  }
  @media (min-width: 40rem) and (max-width: 59.9375rem) {
    .material__pic { max-width: 36rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .materials__frame, .materials.is-enhanced .material { transition: none; }
  }

  /* ---------- planning ---------- */
  .process__intro { display: grid; gap: var(--s-4); align-content: start; }
  .process__pic { margin-block: var(--s-4); }
  .process__split { display: grid; gap: var(--s-2); font-size: var(--fs-small); color: var(--c-muted); max-width: 30em; }
  .process__split strong { color: var(--c-charcoal); }
  .steps { display: grid; position: relative; --progress: 0; }
  .steps__item {
    position: relative;
    display: grid;
    grid-template-columns: clamp(3rem, 6vw, 5rem) 1fr;
    gap: var(--s-4);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-top: var(--border);
  }
  .steps__item:last-child { border-bottom: var(--border); }
  .steps__n { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); font-weight: 250; line-height: 1; color: var(--c-timber); transition: color var(--t-panel) var(--ease); }
  .steps__t { font-size: var(--fs-h3); margin-bottom: 0.4rem; }
  .plan.is-enhanced .steps__item { cursor: pointer; }
  .plan.is-enhanced .steps__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 0;
    background: var(--c-ember);
    transition: width var(--t-panel) var(--ease);
  }
  .plan.is-enhanced .steps__item.is-active::before { width: clamp(3rem, 6vw, 5rem); }
  .plan.is-enhanced .steps__item.is-active .steps__n { color: var(--c-ember-strong); }
  @media (prefers-reduced-motion: reduce) {
    .steps__n, .plan.is-enhanced .steps__item::before { transition: none; }
  }

  /* ---------- installation proof (compact in preview) ---------- */
  .proof__note {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding: var(--s-4) var(--s-5);
    border: 1px dashed var(--c-muted);
    max-width: 44rem;
  }
  .proof__title { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; letter-spacing: 0; }
  .proof__note p { color: var(--c-muted); font-size: var(--fs-small); }

  /* ---------- commercial ---------- */
  .commercial__inner {
    display: grid;
    gap: var(--s-5);
    align-items: end;
  }
  .commercial__copy { display: grid; gap: var(--s-4); }
  .commercial__copy .btn { justify-self: start; }
  @media (min-width: 56.25rem) {
    .commercial__inner { grid-template-columns: 1fr 1fr; align-items: start; gap: var(--s-8); }
  }

  /* closing section: shared styles live in global.css; only the media crop is specific to this page */
  .closing__media .pic { aspect-ratio: 4 / 3; }
  @media (min-width: 60rem) {
    .closing__media .pic { aspect-ratio: 5 / 4; }
  }
</style>
