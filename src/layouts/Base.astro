---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/manrope/index.css';
// the two latin files that every page's first paint needs; nothing else is preloaded
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { currentMode, isPreview } from '@/lib/mode';
import { previewNotice, site } from '@/content/site';
import { absoluteUrl } from '@/lib/site-url';
import { resolve } from '@/lib/mode';

export interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  /** header sits transparent over a hero image (needs an element with [data-hero]) */
  overHero?: boolean;
  /** force noindex (e.g. unapproved policy pages, internal review sheets) */
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  bodyClass?: string;
  /** approved social image (absolute path); defaults to the site-wide one when it has been approved */
  socialImage?: string | null;
  /**
   * Preload the two critical latin font files. Worth it where an image is the largest element (home, model pages):
   * it removes the layout shift from the late font swap. On text-led pages it only adds bytes ahead of the text, so
   * those pages leave it off.
   */
  preloadFonts?: boolean;
}
const { title, description, overHero = false, noindex = false, breadcrumbs, bodyClass = '', socialImage, preloadFonts = false } = Astro.props;
const mode = currentMode();
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const robots = isPreview() || noindex ? 'noindex, nofollow' : 'index, follow';
const canonical = absoluteUrl(path);
// a social image only ever comes from approved content, and only as an absolute URL: never a stock preview
const socialPath = socialImage === undefined ? resolve(site.socialImage) : socialImage;
const socialUrl = socialPath ? absoluteUrl(socialPath) : null;

// BreadcrumbList only when the real domain is known and the trail mirrors visible navigation.
const crumbLd =
  breadcrumbs && breadcrumbs.length && absoluteUrl('/')
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: c.label,
          ...(c.href ? { item: absoluteUrl(c.href) } : {}),
        })),
      }
    : null;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#111c16" />
    {canonical && <link rel="canonical" href={canonical} />}
    {preloadFonts && <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />}
    {preloadFonts && <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialUrl && <meta property="og:image" content={socialUrl} />}
    <meta name="twitter:card" content={socialUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialUrl && <meta name="twitter:image" content={socialUrl} />}
    {crumbLd && <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass} data-content-mode={mode}>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      isPreview() && (
        <div class="preview-bar" role="note">
          <span class="chip">Preview</span>
          <span>{previewNotice}</span>
        </div>
      )
    }
    <Header overHero={overHero} currentPath={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />

    <script>
      // Scroll reveal. Content is visible by default: the page is only marked .reveal-armed (which is what
      // allows .reveal elements to start hidden) once everything below is set up, and elements already on
      // screen are never hidden. If this module fails or is blocked, nothing is ever hidden.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (items.length && !reduce && 'IntersectionObserver' in window) {
        try {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          const vh = window.innerHeight;
          items.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < vh && r.bottom > 0) el.classList.add('is-in');
            else io.observe(el);
          });
          // safety net: never leave anything hidden
          window.setTimeout(() => items.forEach((el) => el.classList.add('is-in')), 4000);
          document.documentElement.classList.add('reveal-armed');
        } catch {
          /* leave everything visible */
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .preview-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem var(--gutter);
    background: var(--c-charcoal);
    color: var(--c-canvas);
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }
  .preview-bar .chip { color: var(--c-ember-on-forest); }
  main:focus { outline: none; }
</style>
