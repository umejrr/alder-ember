{
  "name": "alder-ember",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alder & Ember website - reviewable prototype (Astro + React islands + TypeScript)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:production": "PUBLIC_CONTENT_MODE=production astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "logo": "node scripts/build-logo.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "crawl": "node scripts/crawl-dist.mjs",
    "outbox:retry": "node scripts/outbox-retry.mjs",
    "shots": "node scripts/screenshots.mjs",
    "check:production": "node scripts/check-production.mjs",
    "e2e": "node tests/e2e/journey.mjs",
    "a11y": "node tests/e2e/a11y.mjs",
    "serve": "scripts/serve-dist.sh start",
    "manifest": "node scripts/gen-asset-manifest.mjs && node scripts/gen-image-credits.mjs",
    "build:static": "node scripts/build-static.mjs",
    "package:artifact": "node scripts/package-artifact.mjs",
    "e2e:static": "node tests/e2e/static-bundle.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "astro": "^7.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fontkit": "^2.0.4",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
