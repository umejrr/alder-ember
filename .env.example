# Alder & Ember: environment variables (names only; never commit real values)

# --- Build-time, public (safe to appear in the browser bundle) -------------------
# preview (default): shows working values with a preview notice. production: shows approved/brief values only.
PUBLIC_CONTENT_MODE=preview
# The approved domain. Needed for canonical URLs, sitemap.xml and breadcrumb JSON-LD. APPROVED_DOMAIN_REQUIRED
PUBLIC_SITE_URL=
# Labels the form as a demo unless the deployment really has a configured destination: demo | live
PUBLIC_ENQUIRY_MODE=demo
# Analytics provider id. Empty = no analytics, no consent banner. "console" logs sanitised events in development only.
PUBLIC_ANALYTICS_PROVIDER=

# --- Server-side only (read by src/pages/api/enquiry.ts) -------------------------
# demo (default): validate only, store/send nothing. live: durable outbox + HubSpot; refuses (503) if not configured.
ENQUIRY_MODE=demo
# Where accepted enquiries are written (contains personal data: keep private, apply the approved retention policy).
ENQUIRY_OUTBOX_DIR=./data/outbox
ENQUIRY_RATE_LIMIT_MAX=5
# HubSpot Forms API. Confirm form GUID and property names with Sales first; test against a sandbox form.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Optional JSON override of our-field -> HubSpot internal property name, e.g. {"model":"model_of_interest"}
HUBSPOT_FIELD_MAP=
# Optional: point the adapter at a sandbox or test double instead of https://api.hsforms.com
HUBSPOT_API_BASE=

# Host/port for `npm start`
HOST=0.0.0.0
PORT=4321
